        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>specific category or outcome assigned to an observation by a classification model.</rdfs:comment>
        <rdfs:label>classLabel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classification -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classification">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classificationType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classificationType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classification"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>category or class of prediction that a model is designed to produce.</rdfs:comment>
        <rdfs:label>classificationType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation">
