        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateManagement -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateManagement">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring -->

