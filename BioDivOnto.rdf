        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cropsGrown -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cropsGrown">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cropProduction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cropProduction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>types of crops cultivated by households or farmers for food, income, livestock feed, or other purposes.</rdfs:comment>
        <rdfs:label>cropsGrown</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cultivatingHouseholds -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cultivatingHouseholds">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cropProduction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cropProduction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>number or proportion of households that actively grow or cultivate crops.</rdfs:comment>
        <rdfs:label>cultivatingHouseholds</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#customizationLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#customizationLevel">
