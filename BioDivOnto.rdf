        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific climate information dissemination activity or record.</rdfs:comment>
        <rdfs:label>disseminationId</rdfs:label>
    </owl:DatatypeProperty>
    


