        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>fixed unit of time at which data points in a biodiversity time series are recorded.</rdfs:comment>
        <rdfs:label>timeInterval</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#timeSeriesAnalysis -->

