    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#trendStrength">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#timeSeriesAnalysis"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#timeSeriesAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>measure of how pronounced or consistent a long-term upward or downward pattern is within a biodiversity time series.</rdfs:comment>
        <rdfs:label>trendStrength</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#trustLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#trustLevel">
