        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>current physical, ecological, or environmental state of a specific environmental feature.</rdfs:comment>
        <rdfs:label>featureCondition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#featureId -->

