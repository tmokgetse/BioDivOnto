        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>name given to a specific geographical, environmental, or biodiversity-related feature being identified, recorded, or monitored.</rdfs:comment>
        <rdfs:label>featureName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#featureType -->

