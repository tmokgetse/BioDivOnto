        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>rate or frequency at which new cases of a disease occur within a species population over a given period, used to gauge threats to population health.</rdfs:comment>
        <rdfs:label>diseaseIncidence</rdfs:label>
    </owl:DatatypeProperty>
    


