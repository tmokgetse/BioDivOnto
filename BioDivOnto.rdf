<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/BioDivOnto/"
     xml:base="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/BioDivOnto/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/BioDivOnto">
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#consistOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#consistOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#consists"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanActivity"/>
        <rdfs:comment>Relates a livelihood to the human activities that constitute or form part of that livelihood.</rdfs:comment>
        <rdfs:label>consistOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#consists -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#consists">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanActivity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:comment>Relates a human activity to the livelihood of which it forms a component or contributes to.</rdfs:comment>
        <rdfs:label>consists</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#coveredBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#coveredBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#covers"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#hydrosphere"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:comment>Relates a hydrosphere entity to climate information that describes, monitors, or provides information about it.</rdfs:comment>
        <rdfs:label>coveredBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#covers -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#covers">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#hydrosphere"/>
        <rdfs:comment>Relates climate information to a hydrosphere entity that is described, monitored, or addressed by that information.</rdfs:comment>
        <rdfs:label>covers</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#describedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#describedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#describes"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalFeature"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:comment>Relates an environmental feature to biological indicators that provide information about its condition, characteristics, or ecological status.</rdfs:comment>
        <rdfs:label>describedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#describes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#describes">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalFeature"/>
        <rdfs:comment>Relates a biological indicator to the environmental feature whose condition or characteristics it helps describe or assess.</rdfs:comment>
        <rdfs:label>describes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#enhance -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#enhance">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#enhancedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptive"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:comment>Relates adaptive capacity or adaptation measures to livelihoods that they improve, strengthen, or support.</rdfs:comment>
        <rdfs:label>enhance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#enhancedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#enhancedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptive"/>
        <rdfs:comment>Relates livelihoods to adaptive capacity or adaptation measures that improve, strengthen, or support them.</rdfs:comment>
        <rdfs:label>enhancedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#guidedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#guidedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#guides"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indigenousKnowledge"/>
        <rdfs:comment>Relates livelihoods to indigenous knowledge that informs, influences, or directs livelihood activities and practices</rdfs:comment>
        <rdfs:label>guidedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#guides -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#guides">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indigenousKnowledge"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:comment>Relates indigenous knowledge to livelihoods that it informs, influences, or directs.</rdfs:comment>
        <rdfs:label>guides</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#has -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#has">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isTargetBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#data"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#target"/>
        <rdfs:comment>Relates data to the target that it contains, represents, or is associated with</rdfs:comment>
        <rdfs:label>has</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#hasComponent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#hasComponent">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isComponentOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#weatherTracking"/>
        <rdfs:comment>Relates climate information to the weather tracking information that forms part of it.</rdfs:comment>
        <rdfs:label>hasComponent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#hasDomain -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#hasDomain">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isDomainOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realm"/>
        <rdfs:comment>Relates climate information to the realm or area of knowledge, environment, or subject domain to which it belongs.</rdfs:comment>
        <rdfs:label>hasDomain</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#include -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#include">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#partOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productiveActivities"/>
        <rdfs:comment>Relates livelihoods to the productive activities that form part of or contribute to those livelihoods.</rdfs:comment>
        <rdfs:label>include</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indicatedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indicatedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indicates"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalProcess"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:comment>Relates an environmental process to biological indicators that provide evidence of, or indicate, the occurrence or condition of that process.</rdfs:comment>
        <rdfs:label>indicatedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indicates -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indicates">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalProcess"/>
        <rdfs:comment>Relates biological indicators to an environmental process whose occurrence or condition they provide evidence of.</rdfs:comment>
        <rdfs:label>indicates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#informedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#informedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#informs"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateManagement"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:comment>Relates climate management to the climate predictors that provide information or evidence used to support climate management decisions and actions.</rdfs:comment>
        <rdfs:label>informedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#informs -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#informs">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateManagement"/>
        <rdfs:comment>Relates climate predictors to the climate management decisions or actions that they provide information or evidence for.</rdfs:comment>
        <rdfs:label>informs</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#involve -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#involve">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#involvedIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholders"/>
        <rdfs:comment>Relates livelihoods to the stakeholders who participate in, support, or are affected by those livelihoods.</rdfs:comment>
        <rdfs:label>involve</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#involvedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#involvedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholders"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:comment>Relates stakeholders to the livelihoods in which they participate, provide support, or have an interest.</rdfs:comment>
        <rdfs:label>involvedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isComponentOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isComponentOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#weatherTracking"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:comment>Relates weather tracking information to the climate information of which it forms a component.</rdfs:comment>
        <rdfs:label>isComponentOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isDomainOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isDomainOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realm"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:comment>Relates a realm to the climate information that belongs to or falls within that realm.</rdfs:comment>
        <rdfs:label>isDomainOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isPresentedThrough -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isPresentedThrough">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#presents"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#userInterface"/>
        <rdfs:comment>Relates climate information to the user interface through which it is displayed or presented to users.</rdfs:comment>
        <rdfs:label>isPresentedThrough</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isRepresentedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isRepresentedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#represents"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#spatialRepresentation"/>
        <rdfs:comment>Relates climate information to a spatial representation that visually or geographically represents it.</rdfs:comment>
        <rdfs:label>isRepresentedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isSupportedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isSupportedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#supports"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:comment>Relates climate monitoring to the climate predictors that provide data or information supporting its activities and assessments.</rdfs:comment>
        <rdfs:label>isSupportedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isTargetBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#isTargetBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#target"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#data"/>
        <rdfs:comment>Relates a target to the data that contains, represents, or is associated with it.</rdfs:comment>
        <rdfs:label>isTargetBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#partOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#partOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productiveActivities"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:comment>Relates productive activities to the livelihoods of which they form a component.</rdfs:comment>
        <rdfs:label>partOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perfomedTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perfomedTo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#undergoes"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#preProcessing"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#data"/>
        <rdfs:comment>Relates preprocessing to the data on which the preprocessing activities are performed.</rdfs:comment>
        <rdfs:label>performedTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictedBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predicts"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#forecasting"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:comment>Relates a climate forecasting process to the climate predictors used to generate its predictions.</rdfs:comment>
        <rdfs:label>predictedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predicts -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predicts">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#forecasting"/>
        <rdfs:comment>Relates climate predictors to the climate forecasting process or outcomes that they are used to predict.</rdfs:comment>
        <rdfs:label>predicts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#presents -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#presents">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#userInterface"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:comment>Relates a user interface to the climate information that it displays or presents to users.</rdfs:comment>
        <rdfs:label>presents</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#represents -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#represents">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#spatialRepresentation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:comment>Relates a spatial representation to the climate information that it visually or geographically represents.</rdfs:comment>
        <rdfs:label>represents</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#supports -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#supports">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring"/>
        <rdfs:comment>Relates climate predictors to the climate monitoring activities or assessments that they provide data or information for.</rdfs:comment>
        <rdfs:label>supports</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#undergoes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#undergoes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#data"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#preProcessing"/>
        <rdfs:comment>Relates data to the preprocessing activities that are applied to prepare or transform it.</rdfs:comment>
        <rdfs:label>undergoes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#use -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#use">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#uses"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#timeSeriesAnalysis"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:comment>Relates time series analysis to the prediction model that it uses to analyze temporal data and generate predictions.</rdfs:comment>
        <rdfs:label>use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#uses -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#uses">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#timeSeriesAnalysis"/>
        <rdfs:comment>Relates a prediction model to the time series analysis that it uses to analyze temporal patterns and support predictions.</rdfs:comment>
        <rdfs:label>uses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#utilize -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#utilize">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#utilizedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets"/>
        <rdfs:comment>Relates livelihoods to the assets that they use or depend on to support livelihood activities.</rdfs:comment>
        <rdfs:label>utilize</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#utilizedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#utilizedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:comment>Relates assets to the livelihoods that use or depend on them to support livelihood activities.</rdfs:comment>
        <rdfs:label>utilizedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2002/07/owl#topObjectProperty -->

    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#topObjectProperty">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org#assetDiversity -->

    <owl:DatatypeProperty rdf:about="http://purl.org#assetDiversity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The possession or use of different types of assets to support livelihoods.</rdfs:comment>
        <rdfs:label>assetDiversity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org#eventId -->

    <owl:DatatypeProperty rdf:about="http://purl.org#eventId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific biodiversity or environmental event being recorded or monitored.</rdfs:comment>
        <rdfs:label>eventId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org#preProcessingId -->

    <owl:DatatypeProperty rdf:about="http://purl.org#preProcessingId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#preProcessing"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#preProcessing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific data pre-processing record, allowing it to be distinctly referenced and linked to its associated dataset within the ontology</rdfs:comment>
        <rdfs:label>preProcessingId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org#predictorId -->

    <owl:DatatypeProperty rdf:about="http://purl.org#predictorId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific climate variable or predictor used to predict biodiversity or environmental outcomes.</rdfs:comment>
        <rdfs:label>predictorId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org#targetId -->

    <owl:DatatypeProperty rdf:about="http://purl.org#targetId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#target"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#target"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific target record, allowing it to be distinctly referenced and linked to its associated data within the ontology.</rdfs:comment>
        <rdfs:label>targetId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#accessConstraint -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#accessConstraint">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>factor or condition that limits an individual&apos;s or household&apos;s ability to harvest a given natural resource.</rdfs:comment>
        <rdfs:label>accessConstraint</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#accessRating -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#accessRating">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>qualitative or quantitative measure of how easily an individual or household can obtain a given natural resource.</rdfs:comment>
        <rdfs:label>accessRating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#accuracyScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#accuracyScore">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>measure of how correctly a climate predictor or predictive model estimates or predicts the actual climate-related outcome.</rdfs:comment>
        <rdfs:label>accuracyScore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#activityDuration -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#activityDuration">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanActivity"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>he length of time over which a human activity, such as logging, farming, or tourism, occurs or persists in relation to a given ecosystem or species.</rdfs:comment>
        <rdfs:label>activityDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#activityId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#activityId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanActivity"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific human activity record, allowing it to be distinctly referenced and linked to its associated impacts</rdfs:comment>
        <rdfs:label>activityId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#activityName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#activityName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanActivity"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanActivity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>descriptive label identifying the type of human activity taking place, such as &quot;deforestation,&quot; &quot;poaching,&quot; or &quot;ecotourism.&quot;</rdfs:comment>
        <rdfs:label>activityName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#activityType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#activityType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productiveActivities"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productiveActivities"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>category or classification of an economically productive undertaking</rdfs:comment>
        <rdfs:label>activityType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptionLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptionLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptive"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptive"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The process by which a species becomes fitted to its environment</rdfs:comment>
        <rdfs:label>adaptionLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptive -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptive">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptiveCapacityScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptiveCapacityScore">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptive"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptive"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>Resources available for adaptation to climate change and variability or other related stresses, as well as the ability of a system to use these resources effectively in the pursuit of adaptation</rdfs:comment>
        <rdfs:label>adaptiveCapacityScore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assetId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assetId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Asset identification in biodiversity is the process of identifying, documenting, and mapping the biological resources and ecological features that have ecological, economic, cultural, or conservation value within a specific area.</rdfs:comment>
        <rdfs:label>assetIdentification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assetName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assetName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The identifying label or title given to a specific asset instance, a human-readable string used to identify a particular resource (e.g., equipment, land parcel, building, or livestock unit) within the system.</rdfs:comment>
        <rdfs:label>assetName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assetValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assetValue">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Asset value refers to the monetary worth assigned to a specific asset instance,  typically its estimated or recorded financial value at a given point in time.</rdfs:comment>
        <rdfs:label>assetValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptionDescription -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptionDescription">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptions"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A description of the assumptions made when selecting, developing, interpreting, or applying a climate predictor.</rdfs:comment>
        <rdfs:label>assumptionDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptionId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptionId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptions"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A unique identifier assigned to a specific assumption associated with a climate predictor.</rdfs:comment>
        <rdfs:label>assumptionId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptionType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptionType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptions"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptions"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Specifies the category or nature of an assumption associated with a climate predictor.</rdfs:comment>
        <rdfs:label>assumptionType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptions -->

