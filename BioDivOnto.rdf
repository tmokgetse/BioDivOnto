        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#forecasting"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>span of time from a start point to an end point over which a projected biodiversity outcome is expected to apply or unfold.</rdfs:comment>
        <rdfs:label>forecastPeriod</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#forecasting -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#forecasting">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#frequency -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#frequency">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#reproductiveTasks"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#reproductiveTasks"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>measure of how often a given reproductive-related task or activity is performed within a specified time period.</rdfs:comment>
        <rdfs:label>frequency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#goatHeadCount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#goatHeadCount">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livestockHolding"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livestockHolding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>total number of goats owned or managed by a household or community, used to gauge grazing pressure on natural habitats.</rdfs:comment>
        <rdfs:label>goatHeadCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitat -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitat">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitatArea -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitatArea">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitat"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitat"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>size or spatial extent typically measured in units such as hectares or square kilometres of the physical space that a species or population occupies or relies on for survival.</rdfs:comment>
        <rdfs:label>habitatArea</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitatCondition -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitatCondition">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitat"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitat"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>qualitative or quantitative assessment of the state or quality of a habitat such as intact, degraded, or restored reflecting its capacity to support the species that depend on it.</rdfs:comment>
        <rdfs:label>habitatCondition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitatId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitatId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitat"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitat"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>is a unique identifier assigned to a specific habitat record, allowing it to be distinctly referenced and linked to its associated data</rdfs:comment>
        <rdfs:label>habitatId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitatName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitatName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitat"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#habitat"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>descriptive or designated label used to identify a particular habitat</rdfs:comment>
        <rdfs:label>habitatName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#harvestFrequency -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#harvestFrequency">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>measure of how often a given natural resource is collected or extracted within a specified time period.</rdfs:comment>
        <rdfs:label>harvestFrequency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#harzardType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#harzardType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#droughtImpact"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#droughtImpact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>type of drought-related hazard or environmental condition that causes an impact on biodiversity, ecosystems, or livelihoods.</rdfs:comment>
        <rdfs:label>hazardType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#health -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#health">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#healthStatus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#healthStatus">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#health"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#health"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>overall qualitative or quantitative assessment of an individual&apos;s or population&apos;s physical condition, indicating whether it is healthy, stressed, diseased, or declining.</rdfs:comment>
        <rdfs:label>healthStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#householdRole -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#householdRole">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#conservationOrganisationLinkage"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#conservationOrganisationLinkage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>role or function performed by a household in its relationship or collaboration with a conservation organisation.</rdfs:comment>
        <rdfs:label>householdRole</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanActivity -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanActivity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanCapital -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanCapital">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#hydrosphere -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#hydrosphere">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#implementationDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#implementationDate">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateManagement"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateManagement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>date when a climate management action, strategy, or intervention is put into effect</rdfs:comment>
        <rdfs:label>implementationDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#implementationYear -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#implementationYear">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#institutionalFactors"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#institutionalFactors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>year in which a given policy, regulation, or conservation programme was officially put into effect.</rdfs:comment>
        <rdfs:label>implementationYear</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#incomeAmount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#incomeAmount">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#financialCapital"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#financialCapital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>total amount of money received by a household, individual, or organisation from livelihood activities, employment, investments, or other sources over a specified period.</rdfs:comment>
        <rdfs:label>incomeAmount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#incomeGenerated -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#incomeGenerated">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productiveActivities"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productiveActivities"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>amount of economic return produced by a given productive activity over a specified period.</rdfs:comment>
        <rdfs:label>incomeGenerated</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#incomeLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#incomeLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>measure of the earnings or economic return an individual or household derives from a given livelihood activity, indicating its economic significance relative to natural resource use.</rdfs:comment>
        <rdfs:label>incomeLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#incomeSource -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#incomeSource">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalResourceHarvesting"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalResourceHarvesting"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>specific natural resource or harvesting activity from which an individual or household derives economic benefit.</rdfs:comment>
        <rdfs:label>incomeSource</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indicatorId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indicatorId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A unique identifier assigned to a specific biological indicator to distinguish it from other indicators.</rdfs:comment>
        <rdfs:label>indicatorId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indicatorName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indicatorName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>name assigned to a biological measure used to assess the condition, health, or changes in biodiversity or an ecosystem.</rdfs:comment>
        <rdfs:label>indicatorName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indicatorValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indicatorValue">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>measured or observed value of a biological indicator at a particular time or location.</rdfs:comment>
        <rdfs:label>indicatorValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indigenousKnowledge -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indigenousKnowledge">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#informationId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#informationId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A unique identifier assigned to a specific climate information record.</rdfs:comment>
        <rdfs:label>informationId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#informationType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#informationType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Specifies the category or type of climate information being recorded.</rdfs:comment>
        <rdfs:label>informationType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#infrastructureCondition -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#infrastructureCondition">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#physicalCapital"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#physicalCapital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>qualitative or quantitative assessment of the current state or functionality of built assets  that support conservation or livelihood activities.</rdfs:comment>
        <rdfs:label>infrastructureCondition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#infrastructureType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#infrastructureType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#physicalCapital"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#physicalCapital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>category or classification of a built asset, such as &quot;road,&quot; &quot;borehole,&quot; &quot;fence,&quot; or &quot;storage facility.&quot;</rdfs:comment>
        <rdfs:label>infrastructureType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#institutionalFactors -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#institutionalFactors">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#institutionalLinkages -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#institutionalLinkages">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>class representing the formal and informal connections, coordination mechanisms, and relationships among institutions that shape the governance and management of biodiversity and natural resources.</rdfs:comment>
        <rdfs:label>institutionalLinkages</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#intensity -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#intensity">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomena"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomena"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>measure of the magnitude or severity of an observed natural or climatic event, such as a drought, flood, or heatwave.</rdfs:comment>
        <rdfs:label>intensity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#interceptValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#interceptValue">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#regressionAnalysis"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#regressionAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>numeric estimate of the expected value of a biodiversity outcome when all predictor variables in the model are equal to zero.</rdfs:comment>
        <rdfs:label>interceptValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#interfaceId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#interfaceId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#userInterface"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#userInterface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific user interface record, allowing it to be distinctly referenced and linked to its associated data within the ontology.</rdfs:comment>
        <rdfs:label>interfaceId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#interfaceType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#interfaceType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#userInterface"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#userInterface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>category or form of the interface used to present or collect biodiversity data</rdfs:comment>
        <rdfs:label>interfaceType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#interviewDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#interviewDate">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#villageLocation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#villageLocation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>date on which a survey or interview was conducted at a given village location.</rdfs:comment>
        <rdfs:label>interviewDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#knowledgeDescription -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#knowledgeDescription">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indigenousKnowledge"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indigenousKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>detailed account of a specific piece of traditional or local ecological knowledge, such as a practice, observation, or belief tied to species or ecosystem management.</rdfs:comment>
        <rdfs:label>knowledgeDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#knowledgeName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#knowledgeName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indigenousKnowledge"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indigenousKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>descriptive label or title given to a specific item of indigenous knowledge, such as &quot;seasonal fire management&quot; or &quot;traditional grazing rotation.&quot;</rdfs:comment>
        <rdfs:label>knowledgeName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#knowledgeSource -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#knowledgeSource">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indigenousKnowledge"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#indigenousKnowledge"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>origin of a piece of indigenous knowledge, such as a specific community, elder, or cultural group from which it was recorded or derived.</rdfs:comment>
        <rdfs:label>knowledgeSource</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#language -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#language">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#userInterface"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#userInterface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>specific spoken or written language in which a user interface presents information or receives input</rdfs:comment>
        <rdfs:label>language</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#limitingFactor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#limitingFactor">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#farmingWaterSystem"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#farmingWaterSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>condition or constraint that restricts the availability, access, or effective use of water for farming activities.</rdfs:comment>
        <rdfs:label>limitingFactor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoodDiversification -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoodDiversification">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>class representing the range of different income-generating or subsistence activities that individuals or households undertake, reflecting their level of dependence on and pressure placed on natural resources and ecosystems.</rdfs:comment>
        <rdfs:label>livelihoodDiversification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoodId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoodId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific livelihood record, allowing it to be distinctly referenced and linked to its associated data within the ontology.</rdfs:comment>
        <rdfs:label>livelihoodId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoodType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoodType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>category or classification of a subsistence or income-generating activity, such as &quot;fishing,&quot; &quot;farming,&quot; or &quot;beekeeping.&quot;</rdfs:comment>
        <rdfs:label>livelihoodType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livestockHolding -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livestockHolding">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livestockSpeciesCount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livestockSpeciesCount">
        <rdfs:subPropertyOf rdf:resource="http://purl.org#assetDiversity"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assetDiversity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The number of distinct livestock species (e.g., cattle, goats, sheep, pigs, poultry, camels, donkeys) present or recorded within a given geographic area, farm, dataset, or ontology instance, as opposed to counting individual animals or breeds within a species.</rdfs:comment>
        <rdfs:label>livestockSpeciesCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#managementId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#managementId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateManagement"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateManagement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific climate management action, strategy, programme, or intervention.</rdfs:comment>
        <rdfs:label>managementId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#mapScale -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#mapScale">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#spatialRepresentation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#spatialRepresentation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>ratio between distance on a map and the corresponding real-world distance, determining the level of detail at which biodiversity data is displayed.</rdfs:comment>
        <rdfs:label>mapScale</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#materialId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#materialId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalMaterial"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalMaterial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific material found in or associated with the natural environment.</rdfs:comment>
        <rdfs:label>materialId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#materialName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#materialName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalMaterial"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalMaterial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>name of the specific natural or environmental material being identified, recorded, or monitored.</rdfs:comment>
        <rdfs:label>materialName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#materialType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#materialType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalMaterial"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalMaterial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>category or classification of the environmental material being identified, collected, or monitored.</rdfs:comment>
        <rdfs:label>materialType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#meanSquareError -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#meanSquareError">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#evaluationMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#measurementBasis -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#measurementBasis">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#droughtImpact"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#droughtImpact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>basis, method, or criteria used to measure or assess the severity or extent of drought impacts.</rdfs:comment>
        <rdfs:label>measurementBasis</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#methodName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#methodName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#validationMethods"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#validationMethods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>descriptive label identifying the specific technique used to assess the accuracy of a biodiversity model or dataset.</rdfs:comment>
        <rdfs:label>methodName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#methodUsed -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#methodUsed">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predatorManagement"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predatorManagement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>specific technique or approach employed to reduce or mitigate conflict between predators and human or livestock interests.</rdfs:comment>
        <rdfs:label>methodUsed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#metricId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#metricId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#evaluationMetrics"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#evaluationMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific metric used to evaluate or measure the performance, condition, or outcome of a biodiversity-related activity, model, or process.</rdfs:comment>
        <rdfs:label>metricId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#metricName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#metricName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#evaluationMetrics"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#evaluationMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>name of the specific measurement or indicator used to evaluate the performance, condition, or outcome of a biodiversity-related activity, model, or process.</rdfs:comment>
        <rdfs:label>metricName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#metricValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#metricValue">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#evaluationMetrics"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#evaluationMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>numerical or qualitative result assigned to a specific evaluation metric after measuring or assessing a biodiversity-related activity, model, condition, or process.</rdfs:comment>
        <rdfs:label>metricValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#modelAccuracy -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#modelAccuracy">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>quantitative measure of how closely a predictive model&apos;s outputs match observed real-world outcomes, used to assess its reliability for forecasting.</rdfs:comment>
        <rdfs:label>modelAccuracy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#modelId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#modelId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific prediction model record, allowing it to be distinctly referenced and linked to its associated data within the ontology.</rdfs:comment>
        <rdfs:label>modelId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#modelName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#modelName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>descriptive label identifying a specific predictive model</rdfs:comment>
        <rdfs:label>modelName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#modelVersion -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#modelVersion">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>specific release or iteration identifier of a prediction model, used to track updates and changes to its methodology over time.</rdfs:comment>
        <rdfs:label>modelVersion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#monetisation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#monetisation">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cropFarmingLivestock"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cropFarming"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>conversion of crops or livestock products into monetary income through their sale or other commercial activities.</rdfs:comment>
        <rdfs:label>monetisation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#monitoringFrequency -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#monitoringFrequency">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>how often climate-related conditions, indicators, or environmental changes are measured or observed.</rdfs:comment>
        <rdfs:label>monitoringFrequency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#monitoringId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#monitoringId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific climate monitoring activity, record, or programme.</rdfs:comment>
        <rdfs:label>monitoringId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#monitoringStatus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#monitoringStatus">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>current state or progress of a climate monitoring activity or programme.</rdfs:comment>
        <rdfs:label>monitoringStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#mseValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#mseValue">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#meanSquareError"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#meanSquareError"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>numeric result of averaging the squared differences between a model&apos;s predicted values and the corresponding observed values, used to quantify the accuracy of a biodiversity forecast or model.</rdfs:comment>
        <rdfs:label>mseValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalCapital -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalCapital">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalResourceHarvesting -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalResourceHarvesting">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#natureBenefitScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#natureBenefitScore">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>quantitative or qualitative rating of the value or benefit an individual or household derives from harvesting a given natural resource.</rdfs:comment>
        <rdfs:label>natureBenefitScore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#networkSize -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#networkSize">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#socialCapital"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#socialCapital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>measure of the number of social connections or relationships an individual or household has, reflecting their potential access to shared resources, information, or support relevant to conservation.</rdfs:comment>
        <rdfs:label>networkSize</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#nutritionLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#nutritionLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#health"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#health"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>measure of the adequacy of an individual&apos;s or population&apos;s food intake or nutritional condition, reflecting its capacity to survive, grow, and reproduce.</rdfs:comment>
        <rdfs:label>nutritionLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#observationDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#observationDate">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>specific date on which a climate-related condition, measurement, or environmental observation is recorded.</rdfs:comment>
        <rdfs:label>observationDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#observationTime -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#observationTime">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#weatherTracking"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#weatherTracking"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>specific date and time at which a weather-related measurement was recorded.</rdfs:comment>
        <rdfs:label>observationTime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#observedRange -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#observedRange">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoodDiversification"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoodDiversity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>recorded span or variety of income-generating or subsistence activities that a household or community is actually observed to practice, used to gauge dependence on natural resources.</rdfs:comment>
        <rdfs:label>observedRange</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#occurenceFrequency -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#occurenceFrequency">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomena"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomena"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>measure of how often a given natural or climatic phenomenon takes place within a specified time period.</rdfs:comment>
        <rdfs:label>occurenceFrequency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#offFarmActivities -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#offFarmActivities">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#organisationNamed -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#organisationNamed">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#conservationOrganisationLinkage"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#conservationOrganisationLinkage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>name of the conservation organisation that is linked to, supports, or collaborates with a household, community, or other stakeholder.</rdfs:comment>
        <rdfs:label>organisationNamed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#participatingHouseholds -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#participatingHouseholds">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cropFarmingLivestock"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cropFarming"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>number or proportion of households that engage in both crop farming and livestock-related activities as part of their livelihood.</rdfs:comment>
        <rdfs:label>participatingHouseholds</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#participationLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#participationLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#socialCapital"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#socialCapital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>measure of the extent to which an individual or household engages in community or conservation-related groups, meetings, or activities</rdfs:comment>
        <rdfs:label>participationLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedChange -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedChange">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedTemperatureIncrease"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedTemperatureIncrease"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>qualitative account of how respondents believe local temperatures have shifted over time, based on their own observation rather than instrument measurement.</rdfs:comment>
        <rdfs:label>perceivedChange</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedQualityAdequecy -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedQualityAdequecy">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#farmingWaterSystem"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#farmingWaterSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>farmer’s or household’s perception of whether the available water is of sufficient quality and quantity to meet farming needs.</rdfs:comment>
        <rdfs:label>perceivedQualityAdequecy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedQuantityAdequecy -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedQuantityAdequecy">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#farmingWaterSystem"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#farmingWaterSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>farmer’s or household’s perception of whether the amount of available water is sufficient to meet their farming needs.</rdfs:comment>
        <rdfs:label>perceivedQuanitityAdequecy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedTemperatureIncrease -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedTemperatureIncrease">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomena -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomena">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomenonId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomenonId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomena"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomena"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific phenomenon record, allowing it to be distinctly referenced and linked to its associated data within the ontology.</rdfs:comment>
        <rdfs:label>phenomenonId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomenonName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomenonName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomena"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#phenomena"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>descriptive label identifying the specific natural or climatic event being recorded.</rdfs:comment>
        <rdfs:label>phenomenonName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#physicalCapital -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#physicalCapital">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#policyName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#policyName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#institutionalFactors"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#institutionalFactors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>descriptive title identifying a specific policy, law, or regulatory instrument relevant to conservation or resource management.</rdfs:comment>
        <rdfs:label>policyName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#policyType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#policyType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#institutionalFactors"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#institutionalFactors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>category or classification of a policy, such as legislative, regulatory, or voluntary describing the nature of the instrument used to govern biodiversity-related actions.</rdfs:comment>
        <rdfs:label>policyType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#poultryHeadCount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#poultryHeadCount">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livestockHolding"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livestockHolding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>total number of poultry owned or managed by a household or community, used to gauge resource use and disease-transmission risk to wildlife.</rdfs:comment>
        <rdfs:label>poultryHeadCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#practiceUsed -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#practiceUsed">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#sustainablePractice"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#sustainablePractice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>specific method or technique, such as rotational grazing, agroforestry, or controlled burning,  employed to manage natural resources in a way that maintains ecosystem health over the long term.</rdfs:comment>
        <rdfs:label>practiceUsed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#preProcessing -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#preProcessing">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#data"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#precisionScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#precisionScore">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classification"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>proportion of predicted positive cases that are actually correct.</rdfs:comment>
        <rdfs:label>precisionScore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predatorLivestockLoss -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predatorLivestockLoss">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predatorManagement -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predatorManagement">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predatorSpecies -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predatorSpecies">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predatorLivestockLoss"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predatorLivestockLoss"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>specific type of predator, such as lion, hyena, or leopard,  identified as responsible for a recorded instance of livestock loss.</rdfs:comment>
        <rdfs:label>predatorSpecies</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictorName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictorName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>name of the climate-related variable used as a predictor of biodiversity or environmental conditions.</rdfs:comment>
        <rdfs:label>predictorName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictorType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictorType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>category or type of climate variable used to predict biodiversity or environmental outcomes.</rdfs:comment>
        <rdfs:label>predictorType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#process -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#process">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processDuration -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processDuration">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalProcess"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalProcess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>length of time required for an environmental process or event to occur, from its beginning to its end.</rdfs:comment>
        <rdfs:label>processDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalProcess"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalProcess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific environmental process or event being recorded, monitored, or analysed.</rdfs:comment>
        <rdfs:label>processId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalProcess"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalProcess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>name given to a specific environmental process or event that occurs in an ecosystem or affects biodiversity.</rdfs:comment>
        <rdfs:label>processName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processRate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processRate">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalProcess"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalProcess"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>speed or frequency at which an environmental process occurs or changes over a specified period of time.</rdfs:comment>
        <rdfs:label>processRate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processStatus -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processStatus">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#process"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#process"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The current state or stage of a climate-related process being observed or recorded.</rdfs:comment>
        <rdfs:label>processStatus</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processingDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#processingDate">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#preProcessing"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#preProcessing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>date on which raw data was cleaned, transformed, or prepared for analysis or modelling.</rdfs:comment>
        <rdfs:label>processingDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productionEquipmentTypeCount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productionEquipmentTypeCount">
        <rdfs:subPropertyOf rdf:resource="http://purl.org#assetDiversity"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assetDiversity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The number of distinct categories (types) of equipment used in a production system, as opposed to the total number of individual equipment units owned or operated.</rdfs:comment>
        <rdfs:label>productionEquipmentTypeCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productionLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productionLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productiveActivities"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productiveActivities"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>quantitative measure of the output or yield achieved by a given productive activity, such as crop volume or livestock weight gain.</rdfs:comment>
        <rdfs:label>productionLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productiveActivities -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#productiveActivities">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#property -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#property">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#propertyName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#propertyName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#property"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#property"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>descriptive label identifying a specific attribute or characteristic being recorded</rdfs:comment>
        <rdfs:label>propertyName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#propertyValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#propertyValue">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#property"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#property"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>corresponding measured or observed data assigned to that attribute.</rdfs:comment>
        <rdfs:label>propertyValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#publicationDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#publicationDate">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalMaterial"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#environmentalMaterial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>date on which information, data, a report, dataset, or other documented material about the environment is officially published or made available.</rdfs:comment>
        <rdfs:label>publicationDate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#rSquared -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#rSquared">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#regressionAnalysis"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#regressionAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>statistic indicating the proportion of variance in a biodiversity outcome that is explained by the predictor variables in the regression model.</rdfs:comment>
        <rdfs:label>rSquared</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#raiderSpecies -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#raiderSpecies">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#wildlifeCropDamage"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#wildlifeCropDamage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>specific type of wild animal identified as responsible for a recorded instance of crop damage.</rdfs:comment>
        <rdfs:label>raiderSpecies</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#rainfall -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#rainfall">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#weatherTracking"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#weatherTracking"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>amount of precipitation recorded at a given location and time, relevant to habitat conditions and species behaviour.</rdfs:comment>
        <rdfs:label>rainfall</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realm -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realm">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realmDescription -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realmDescription">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realm"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>detailed account of the ecological or biogeographic characteristics that define a specific realm.</rdfs:comment>
        <rdfs:label>realmDescription</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realmId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realmId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realm"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific realm record, allowing it to be distinctly referenced and linked to its associated data within the ontology.</rdfs:comment>
        <rdfs:label>realmId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realmName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realmName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realm"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#realm"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>descriptive label identifying a major biogeographic division of the Earth, such as &quot;Afrotropical&quot; or &quot;Palearctic,&quot; characterized by distinct flora and fauna.</rdfs:comment>
        <rdfs:label>realmName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#recallScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#recallScore">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classification"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>proportion of actual positive cases that the model correctly identifies.</rdfs:comment>
        <rdfs:label>recallScore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#regressionAnalysis -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#regressionAnalysis">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#predictionModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#regressionType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#regressionType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#regressionAnalysis"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#regressionAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>category or form of statistical model used to analyze relationships between variables, such as &quot;linear,&quot; &quot;logistic,&quot; or &quot;polynomial&quot; regression.</rdfs:comment>
        <rdfs:label>regressionType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#relationshipQuality -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#relationshipQuality">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#conservationOrganisationLinkage"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#conservationOrganisationLinkage"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>perceived strength, effectiveness, and quality of the relationship between a household, community, or stakeholder and a conservation organisation.</rdfs:comment>
        <rdfs:label>relationshipQuality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#reportedImpact -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#reportedImpact">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedTemperatureIncrease"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedTemperatureIncrease"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>specific consequence, such as crop loss, species decline, or water scarcity, that respondents attribute to the perceived rise in temperature.</rdfs:comment>
        <rdfs:label>reportedImpact</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#reportedOutcome -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#reportedOutcome">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#droughtImpact"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#droughtImpact"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>observed or reported result or consequence of a drought event on biodiversity, ecosystems, or livelihoods.</rdfs:comment>
        <rdfs:label>reportedOutcome</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#reportingHouseholds -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#reportingHouseholds">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedTemperatureIncrease"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedTemperatureIncrease"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>count or set of households that provided a response regarding their perception of temperature change and its effects.</rdfs:comment>
        <rdfs:label>reportingHouseholds</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#reproductiveTasks -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#reproductiveTasks">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceCondition -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceCondition">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalCapital"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalCapital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>qualitative or quantitative assessment of the current state of a natural resource reflecting its capacity to sustain ecosystem functions.</rdfs:comment>
        <rdfs:label>resourceCondition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvested -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvested">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceHarvest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>specific natural resource that is collected or extracted from the environment.</rdfs:comment>
        <rdfs:label>resourceHarvested</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceQuality -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceQuality">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalCapital"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalCapital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>measure of how well a natural resource meets the standards or requirements needed to support ecosystem health and species survival.</rdfs:comment>
        <rdfs:label>resourceQuality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceScore">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptive"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptive"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>a metric that evaluates a company&apos;s efficiency in using resources, particular in terms of minimizing material, energy, and water consuption.</rdfs:comment>
        <rdfs:label>resourceScore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#resourceType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalCapital"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#naturalCapital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>category or classification of a natural asset, such as &quot;forest,&quot; &quot;water,&quot; &quot;soil,&quot; or &quot;mineral deposit.&quot;</rdfs:comment>
        <rdfs:label>resourceType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#rnseValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#rnseValue">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#rootMeanSquaredError"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#rootMeanSqauredError"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>numeric result of taking the square root of the mean squared differences between a model&apos;s predicted values and the corresponding observed values, used to quantify the accuracy of a biodiversity forecast or model in the same units as the original data.</rdfs:comment>
        <rdfs:label>rnseValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#rootMeanSquaredError -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#rootMeanSquaredError">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#evaluationMetrics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Measures the square root of the average squared difference between predicted and actual values, expressed in the same units as the predicted variable.</rdfs:comment>
        <rdfs:label>rootMeanSquaredError</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#salinity -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#salinity">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#hydrosphere"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#hydrosphere"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>concentration of dissolved salts in a water body, a key factor determining which aquatic species and ecosystems can survive there.</rdfs:comment>
        <rdfs:label>salinity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#savingsAmount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#savingsAmount">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#financialCapital"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#financialCapital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>total amount of money that a household, individual, or organisation has saved or set aside for future needs, investments, emergencies, or other purposes.</rdfs:comment>
        <rdfs:label>savingsAmount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#seasonalityPeriod -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#seasonalityPeriod">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#timeSeriesAnalysis"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#timeSeriesAnalysis"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>recurring interval over which a cyclical pattern in a biodiversity variable, like rainfall or species abundance, repeats.</rdfs:comment>
        <rdfs:label>seasonalityPeriod</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#sensitivityScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#sensitivityScore">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#vulnerabilityContext"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#vulnerabilityContext"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment>quantitative or qualitative rating of how strongly a species, community, or ecosystem is affected by a given exposure to stress.</rdfs:comment>
        <rdfs:label>sensitivityScore</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#sheepHeadCount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#sheepHeadCount">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livestockHolding"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livestockHolding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>total number of sheep owned or managed by a household or community, used to gauge grazing pressure on natural habitats.</rdfs:comment>
        <rdfs:label>sheepHeadCount</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#skillLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#skillLevel">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanCapital"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#humanCapital"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>qualitative or quantitative measure of an individual&apos;s proficiency or competence in tasks relevant to conservation, monitoring, or resource management.</rdfs:comment>
        <rdfs:label>skillLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#socialCapital -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#socialCapital">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#source -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#source">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Identifies the origin or provider of the climate information.</rdfs:comment>
        <rdfs:label>source</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#spatialRepresentation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#spatialRepresentation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#spatialResolution -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#spatialResolution">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#spatialRepresentation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#spatialRepresentation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>smallest distinguishable unit of area at which biodiversity data is captured or represented.</rdfs:comment>
        <rdfs:label>spatialResolution</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholderId -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholderId">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholders"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>unique identifier assigned to a specific stakeholder record, allowing it to be distinctly referenced and linked to its associated data within the ontology.</rdfs:comment>
        <rdfs:label>stakeholderId</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholderName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholderName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholders"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>descriptive label identifying a specific stakeholder, such as an individual, community, or organization.</rdfs:comment>
        <rdfs:label>stakeholderName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholderRole -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholderRole">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholders"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholders"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>specific function or capacity that a stakeholder holds in relation to biodiversity conservation and management.</rdfs:comment>
        <rdfs:label>stakeholderRole</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholders -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stakeholders">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#livelihoods"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#strategyName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#strategyName">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateManagement"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateManagement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>name given to a specific strategy or approach used to address climate-related risks and impacts on biodiversity.</rdfs:comment>
        <rdfs:label>strategyName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stressorType -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#stressorType">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedTemperatureIncrease"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#perceivedTemperatureIncrease"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>category of environmental or climatic pressure; such as heat stress, drought, or erratic rainfall, that respondents associate with the perceived temperature increase.</rdfs:comment>
        <rdfs:label>stressorType</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#substance -->

