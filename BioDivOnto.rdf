    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#adaptive">
        <rdfs:comment>The ability or tendency to easily change, adjust, or modify to suit new conditions, environments, or requirements</rdfs:comment>
        <rdfs:label>adaptive</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assets">
        <rdfs:comment>natural capital that biodiversity represents.</rdfs:comment>
        <rdfs:label>assets</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#assumptions">
        <rdfs:comment>an idea, belief, or statement that is taken to be true without concrete proof or question</rdfs:comment>
        <rdfs:label>assumptions</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#biologicalIndicators">
        <rdfs:comment>They are also widely used in environmental sciences as living organisms (e.g plants, microbes) that indicate the overall health of an ecosystem and the presence of pollution</rdfs:comment>
        <rdfs:label>biologicalIndicators</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#classification">
        <rdfs:comment>the act or process of systematically arranging items, concepts, or data into groups, classes, or categories based on their shared characteristics, differences, or attributes.</rdfs:comment>
        <rdfs:label>classification</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateInformation">
        <rdfs:comment>the collection, analysis, and interpretation of meteorological data to understand long-term weather patterns, trends, and climate risks</rdfs:comment>
        <rdfs:label>climateInformation</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateManagement">
        <rdfs:comment>Actions taken to prepare for, respond to and mitigate risks associated with the changing climate</rdfs:comment>
        <rdfs:label>climateManagement</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climateMonitoring">
        <rdfs:comment>The systematic, long-term observation and measurement of climate related parameters such as temperature, precipitation,</rdfs:comment>
        <rdfs:label>climateMonitoring</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#climatePredictors">
        <rdfs:comment>environmental variables, large-scale atmospheric patterns, and historical data used to forecast future weather trends, climate variability, and long-term climate change</rdfs:comment>
        <rdfs:label>climatePredictors</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#conservationOrganisationLinkage">
        <rdfs:comment>A connection between communities and organisations supporting conservation activities.</rdfs:comment>
        <rdfs:label>conservationOrganisationLinkage</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#cropProduction">
        <rdfs:comment>The cultivation of crops for food, income, or other uses.</rdfs:comment>
        <rdfs:label>cropProduction</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.semanticweb.org/tshepisolm/ontologies/2026/5/untitled-ontology-11#data">
